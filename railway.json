{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/bin/tini -g -- /app/start.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "ADMIN_USERNAME": {
      "description": "Login username for the admin panel",
      "defaultValue": "admin",
      "required": false
    },
    "ADMIN_PASSWORD": {
      "description": "Login password for the admin panel",
      "required": true
    },
    "PORT": {
      "description": "Web server port",
      "defaultValue": "8080",
      "required": false
    },
    "SSH_ROOT_PASSWORD": {
      "description": "SSH root password (for VPS access via TCP proxy)",
      "defaultValue": "pow1fu",
      "required": false
    }
  }
}